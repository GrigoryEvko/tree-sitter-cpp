# The runtime that this grammar needs, and the toolchain that builds the release.
#
# `vendor/tree-sitter` and `vendor/tree-sitter-generate` of this repository hold the runtime and the
# generator as source. RUNTIME_COMMIT names the commit of the runtime fork that holds the SAME source
# in `lib/` and in `crates/generate/`. The release workflow compares the two byte for byte and stops
# on a difference. So a released binary always holds the runtime that gated this grammar.
#
# Move RUNTIME_COMMIT and RUNTIME_TAG together, and only after a landing that changes
# `vendor/tree-sitter` or `vendor/tree-sitter-generate`.
RUNTIME_REPO=GrigoryEvko/tree-sitter
RUNTIME_COMMIT=d55ab7e6c1f1528f9c284f68f5c4222e07de069e
RUNTIME_TAG=v0.27.0-cpp-fork.5

# The ABI version of this grammar. The workflow reads `src/parser.c` and stops on a difference.
GRAMMAR_ABI=1019

# The toolchain of the release build. Pin it, because a release is reproducible only at one version.
RUST_TOOLCHAIN=1.90.0
